<http://example.org/doc/0#char=0,168> a nif:Context,
        nif:RFC5147String,
        nif:String ;
    nif:beginIndex "0"^^xsd:nonNegativeInteger ;
    nif:endIndex "168"^^xsd:nonNegativeInteger ;
    nif:isString "Matatagpuan ang Capraia Isola 64 kilometer mula sa Livorno, 53 kilometer mula sa promontoryo ng Piombino, 37 kilometer mula sa Gorgona, at 31 kilometer mula sa Corsica." .

<http://example.org/doc/1#char=0,204> a nif:Context,
        nif:RFC5147String,
        nif:String ;
    nif:beginIndex "0"^^xsd:nonNegativeInteger ;
    nif:endIndex "204"^^xsd:nonNegativeInteger ;
    nif:isString "Ang bayan ng Noto, na bahagi ng kilalang rehiyon ng Val di Noto, ay muling itinayo sa estilong Barokong Siciliano at ngayon ay isang sikat na destinasyon ng turista dahil sa kanyang magandang arkitektura." .

<http://example.org/doc/10#char=0,74> a nif:Context,
        nif:RFC5147String,
        nif:String ;
    nif:beginIndex "0"^^xsd:nonNegativeInteger ;
    nif:endIndex "74"^^xsd:nonNegativeInteger ;
    nif:isString "Ang kompanya na kilala bilang Aaron Corp ay isang bagong negosyo sa bansa." .

<http://example.org/doc/100#char=0,259> a nif:Context,
        nif:RFC5147String,
        nif:String ;
    nif:beginIndex "0"^^xsd:nonNegativeInteger ;
    nif:endIndex "259"^^xsd:nonNegativeInteger ;
    nif:isString "Sa bansang Republikang Bayan ng Bangladesh, matatagpuan ang punong-tanggapan ng Bay of Bengal Initiative for Multi-Sectoral Technical and Economic Cooperation (BIMSTEC, Inisyatibong Look ng Bengal para sa Multi-Sektoral na Teknikal at Kooperasyong Ekonomiko)." .

<http://example.org/doc/101#char=0,128> a nif:Context,
        nif:RFC5147String,
        nif:String ;
    nif:beginIndex "0"^^xsd:nonNegativeInteger ;
    nif:endIndex "128"^^xsd:nonNegativeInteger ;
    nif:isString "Si Blakdyak ay kilala sa bansa bilang \"Hari ng Pinoy Reggae\" dahil sa kanyang mga kontribusyon sa lokal na industriya ng musika." .

